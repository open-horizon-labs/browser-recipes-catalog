{
  "id": "compare-hacker-news",
  "title": "Compare Hacker News headlines",
  "description": "Read the leading front-page and newest headlines in one Hacker News tab.",
  "tabs": {
    "news": {
      "adapterId": "hacker-news",
      "label": "Hacker News tab"
    }
  },
  "steps": [
    {
      "id": "read-front",
      "label": "Read the front page",
      "op": "recipe",
      "tab": "news",
      "recipeId": "front-page",
      "effect": "read"
    },
    {
      "id": "read-new",
      "label": "Read the newest page",
      "op": "recipe",
      "tab": "news",
      "recipeId": "newest",
      "effect": "read"
    },
    {
      "id": "compare",
      "label": "Compare the two headlines",
      "op": "transform",
      "transform": "compare-values",
      "inputs": {
        "left": "read-front.headline",
        "right": "read-new.headline"
      }
    }
  ]
}
