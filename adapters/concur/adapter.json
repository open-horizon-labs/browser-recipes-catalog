{
  "id": "concur",
  "title": "SAP Concur Expense (US2)",
  "origin": "https://us2.concursolutions.com",
  "auth": {
    "entryPath": "/nui/expense",
    "paths": [
      "/nui/signin",
      "/nui/signin/"
    ]
  },
  "targets": {
    "manage-expenses": "[role=main] h1.sapcnqr-toolbar__title",
    "first-report": "section.active-reports .report-tiles-container > li.report-tile:nth-child(1 of li.report-tile) > a.sapcnqr-grid-list-item__link",
    "report-number": "button[aria-label^=\"Report Number:\"]",
    "expense-grid": "[role=\"table\"][aria-label=\"A List of Expense Entries\"]",
    "report-details": "#reportDetailsOpener",
    "transaction-date": "input#transactionDate-date-input-field-input",
    "hotel-date-range": "input#hotelCheckinDate-date-input-field-input",
    "business-purpose": "input#businessPurpose",
    "vendor": "input#vendorAndVendorName",
    "expense-amount": "input#transactionAmount",
    "report-title": "[role=\"main\"] h1.sapcnqr-object-header__title-main",
    "report-dialog": "[role=\"dialog\"][aria-modal=\"true\"]",
    "dialog-button": "[role=\"dialog\"][aria-modal=\"true\"] button",
    "toolbar-button": "[role=\"main\"] button.sapcnqr-toolbar__item",
    "menu-items": "button.sapcnqr-menu-button-item__item-button[role=\"menuitem\"]",
    "tabs": "[role=\"tab\"]",
    "add-expense": "button.add-expense-menu-button",
    "expense-type-option": "[role=\"option\"][id]:not([id*=\"mruHeader\"])",
    "picker-button": "button[aria-label]",
    "picker-search": ".sapcnqr-selection-list__search-field input",
    "picker-option": ".sapcnqr-selection-list [role=\"option\"]",
    "expense-vendor": "input#vendorName",
    "expense-note": "textarea#orgUnit1",
    "receipt-buttons": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] button[aria-label^=\"View receipt\"]",
    "report-rows": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] [role=\"row\"]:has(.date-cell)",
    "report-selection": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] [role=\"row\"] input[type=\"checkbox\"]:not(:checked)",
    "selected-report-row": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] [role=\"row\"]:has(input[type=\"checkbox\"]:checked):has([role=\"cell\"])",
    "selected-row-actions": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] [role=\"row\"]:has(input[type=\"checkbox\"]:checked) button.entries-list-actions-button",
    "itemizations-table": "[role=\"table\"][aria-label=\"Itemizations\"], table[aria-label=\"Itemizations\"]",
    "available-panel": "[role=\"dialog\"] [role=\"tabpanel\"]",
    "available-selection": "[role=\"dialog\"] [role=\"tabpanel\"] [role=\"row\"]:has([role=\"cell\"]) input[type=\"checkbox\"]:not(:checked)",
    "available-checked": "[role=\"dialog\"] [role=\"tabpanel\"] [role=\"row\"]:has([role=\"cell\"]) input[type=\"checkbox\"]:checked",
    "allocation-table": "[role=\"dialog\"] [role=\"table\"][aria-label=\"Allocations\"]",
    "allocation-percent": "[role=\"dialog\"] [role=\"table\"][aria-label=\"Allocations\"] [role=\"row\"] input:not([type=\"checkbox\"])",
    "room-rate-inputs": "input[aria-label^=\"Room Rate for\"]",
    "submit-button": "button[aria-label=\"Submit Report\"]:not(:disabled):not([aria-disabled=\"true\"])",
    "approval-status": "[role=\"dialog\"] input#approvalStatus",
    "report-total": "[role=\"dialog\"] input#reportTotal",
    "reimbursement": "[role=\"dialog\"] input#amountDueEmployee",
    "ride-from": "input#fromLocation",
    "ride-to": "input#toLocation",
    "upload-receipt": "input[type=\"file\"]#upload-file",
    "expense-save": "button.sapcnqr-split-button__action.sapcnqr-toolbar__item",
    "itemization-save": "button.sapcnqr-split-button__action.sapcnqr-toolbar__item",
    "alert-dialog": "[role=\"alertdialog\"]",
    "alert-button": "[role=\"alertdialog\"] button",
    "modal-heading": "[role=\"dialog\"] h2",
    "allocation-clear": "[role=\"dialog\"] button[aria-label=\"Clear\"]",
    "submit-review-button": "[role=\"dialog\"][aria-modal=\"true\"] button, [role=\"alertdialog\"] button",
    "allocation-inputs": "[role=\"dialog\"] [role=\"table\"][aria-label=\"Allocations\"] input[type=\"checkbox\"]:not(:checked)",
    "editor-heading": "h2",
    "selected-allocation-row": "[role=\"dialog\"] [role=\"table\"][aria-label=\"Allocations\"] [role=\"row\"]:has([role=\"cell\"]):has(input[type=\"checkbox\"]:checked)",
    "new-allocation-button": "[role=\"dialog\"][aria-modal=\"true\"]:not(:has([role=\"table\"][aria-label=\"Allocations\"])) button",
    "report-checkboxes": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] [role=\"row\"]:has([role=\"cell\"]) input[type=\"checkbox\"]",
    "available-checkboxes": "[role=\"dialog\"] [role=\"tabpanel\"] [role=\"row\"]:has([role=\"cell\"]) input[type=\"checkbox\"]",
    "picker-results": ".sapcnqr-selection-list [role=\"group\"][aria-labelledby]:not([aria-labelledby*=\" \"]) [role=\"option\"]",
    "new-allocation-dialog": "[role=\"dialog\"][aria-modal=\"true\"]:not(:has([role=\"table\"][aria-label=\"Allocations\"]))",
    "itemization-toggle": "button[aria-label=\"Show Itemizations Summary\"]",
    "itemization-dialog": "[role=\"dialog\"]:has([aria-label=\"Itemization Summary\"])",
    "itemization-close": "[role=\"dialog\"]:has([aria-label=\"Itemization Summary\"]) button",
    "report-alerts": "[role=\"table\"][aria-label=\"A List of Expense Entries\"] button:is([aria-label^=\"Show Error\"],[aria-label^=\"Show Warning\"])",
    "report-header-dismiss": "[role=\"dialog\"] .report-header-button-container button.sapcnqr-button--link",
    "active-report-cards": "section.active-reports .report-tiles-container > li.report-tile:has(a.sapcnqr-grid-list-item__link)"
  },
  "backgroundOnly": true
}
