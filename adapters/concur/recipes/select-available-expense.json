{
  "id": "select-available-expense",
  "title": "Stage one exactly identified available-expense row",
  "kind": "update",
  "effect": "write",
  "inputs": {
    "report-number": {
      "type": "string",
      "required": true
    },
    "available-label": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "op": "assert",
      "target": "report-number",
      "match": {
        "input": "report-number"
      }
    },
    {
      "op": "click",
      "target": "available-selection",
      "match": {
        "input": "available-label",
        "attribute": "label"
      }
    }
  ]
}
