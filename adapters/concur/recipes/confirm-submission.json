{
  "id": "confirm-submission",
  "title": "Accept the reviewed agreement and submit the report",
  "kind": "submit",
  "effect": "write",
  "inputs": {
    "report-number": {
      "type": "string",
      "required": true
    },
    "reviewed-dialog": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "op": "assert",
      "target": "report-number",
      "match": {
        "input": "report-number"
      }
    },
    {
      "op": "assert",
      "target": "report-dialog",
      "match": {
        "input": "reviewed-dialog"
      }
    },
    {
      "op": "click",
      "target": "submit-review-button",
      "match": {
        "text": "Accept & Submit"
      }
    }
  ]
}
