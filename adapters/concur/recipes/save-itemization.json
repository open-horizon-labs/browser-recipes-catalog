{
  "id": "save-itemization",
  "title": "Save the reviewed hotel itemization on this draft",
  "inputs": {
    "report-number": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "op": "assert",
      "target": "report-number",
      "match": {
        "input": "report-number"
      }
    },
    {
      "op": "click",
      "target": "report-number"
    },
    {
      "op": "assertValue",
      "target": "approval-status",
      "value": "Not Submitted"
    },
    {
      "op": "click",
      "target": "report-header-dismiss"
    },
    {
      "op": "assert",
      "target": "editor-heading",
      "match": {
        "text": "Add Itemization"
      }
    },
    {
      "op": "click",
      "target": "itemization-save",
      "match": {
        "text": "Save Itemization"
      }
    }
  ]
}
