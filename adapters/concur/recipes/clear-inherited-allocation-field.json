{
  "id": "clear-inherited-allocation-field",
  "title": "Clear the reviewed conflicting allocation field",
  "inputs": {
    "report-number": {
      "type": "string",
      "required": true
    },
    "field-text": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "op": "assert",
      "target": "report-number",
      "match": {
        "input": "report-number"
      }
    },
    {
      "op": "click",
      "target": "allocation-clear",
      "match": {
        "input": "field-text",
        "within": ".sapcnqr-form-field"
      }
    }
  ]
}
