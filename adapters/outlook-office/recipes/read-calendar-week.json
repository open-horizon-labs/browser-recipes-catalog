{
  "id": "read-calendar-week",
  "title": "Read the visible Outlook calendar week",
  "kind": "list",
  "effect": "read",
  "steps": [
    {
      "op": "assert",
      "target": "calendar-range"
    },
    {
      "op": "read",
      "target": "calendar-range",
      "as": "range"
    },
    {
      "op": "readList",
      "target": "calendar-events",
      "attributes": [
        "aria-label"
      ],
      "as": "events"
    },
    {
      "op": "readList",
      "target": "calendar-filter",
      "attributes": [
        "aria-label"
      ],
      "as": "filters"
    },
    {
      "op": "readList",
      "target": "calendar-account",
      "attributes": [
        "aria-label"
      ],
      "as": "account"
    }
  ],
  "calendarRange": true,
  "inputs": {
    "first-day": {
      "type": "string"
    },
    "last-day": {
      "type": "string"
    }
  }
}
